OPENAI_API_KEY=

BERN2_API_URL=

# CogStack MedCATservice: POST /api/process (see docs/MEDCAT_GUIDE.md).
# You may set only http://127.0.0.1:5555 — the client appends /api/process if missing.
MEDCAT_API_URL=http://127.0.0.1:5555/api/process

# Optional: drop MedCAT spans below this acc / context_similarity (0..1). Example: 0.55
# MEDCAT_MIN_ACC=0.55

# If you map the container to host port 5000 instead of 5555:
# MEDCAT_API_URL=http://127.0.0.1:5000/api/process

